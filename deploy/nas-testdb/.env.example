# Copy to .env next to docker-compose.yml and fill in. See README.md.

# The nas-testdb function of your get.ride backend.
GETRIDE_URL=https://rqlavogkgywxspuxgiwk.supabase.co/functions/v1/nas-testdb

# The connection code from Admin > Settings > Office NAS > Test database >
# Connect. Needed once; remove it after the runner says "Connected".
PAIR_CODE=

# Optional: the name shown in Admin (else the one typed when making the code).
RUNNER_LABEL=

# The test copy's own Postgres password (letters and digits only, 24 or more).
# It never leaves the NAS.
LOCAL_DB_PASSWORD=

# Where deploy/nas-backup writes the nightly database backups, on the NAS.
# The newest one (36 hours old at most) is restored. Leave as it is if there
# are no backups on the NAS yet: the runner then dumps the live database
# itself with SOURCE_DB_URL.
BACKUPS_HOST_DIR=./backups
BACKUP_MAX_AGE_HOURS=36

# Read-only connection to the LIVE database, used only when there is no
# fresh backup. Use the Session pooler address (Supabase > Connect > Session
# pooler; the direct address needs IPv6) and the read-only "nas_reader" user
# from README.md step 1, never the postgres password.
# postgresql://nas_reader.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
SOURCE_DB_URL=

# GitHub, read-only: a fine-grained token for this repository with
# Contents: Read-only and Pull requests: Read-only (README.md step 2).
GITHUB_REPO=getgroupmy/get-ride
GITHUB_TOKEN=

# Office time for the nightly refresh set in Admin.
TZ=Asia/Kuala_Lumpur

# Optional: the Postgres image (keep it Supabase's, major version 17).
# PG_IMAGE=supabase/postgres:17.4.1.054

# 1 (default): each migration file runs in one transaction, as Supabase does.
SINGLE_TRANSACTION=1
