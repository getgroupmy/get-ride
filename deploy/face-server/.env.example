# Copy to .env (never commit it). Both are secrets.
# The key the get.ride server sends in x-api-key: openssl rand -hex 32
FACE_API_KEY=
# Cloudflare Zero Trust > Networks > Tunnels > your tunnel: the token.
TUNNEL_TOKEN=
# SFace (default) or Dlib (then also WITH_DLIB=1).
FACE_MODEL=SFace
WITH_DLIB=0
FACE_MAX_IMAGE_MB=6
