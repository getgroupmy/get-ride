# Copy to .env next to docker-compose.yml and fill in. See README.md.

# Umami's own database password (letters and digits, 24 or more). Never
# leaves the NAS. `openssl rand -hex 16` makes one.
UMAMI_DB_PASSWORD=

# Signs Umami's logins. Any long random text: `openssl rand -hex 32`.
UMAMI_APP_SECRET=

# The tunnel's token from Cloudflare Zero Trust > Networks > Tunnels
# (README.md, step 1): the long text after --token.
TUNNEL_TOKEN=

# Optional: another Umami image (Postgres build). The nas-stats function
# reads Umami 2 and 3.
# UMAMI_IMAGE=ghcr.io/umami-software/umami:postgresql-v2.13.2
