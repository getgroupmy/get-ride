# Copy to .env next to docker-compose.yml and fill in. See README.md.
# Keep this file to yourself: chmod 600 .env

# The nas-ops function of your GET.ride backend.
GETRIDE_URL=https://rqlavogkgywxspuxgiwk.supabase.co/functions/v1/nas-ops

# The connection code from Admin > Settings > Office NAS > Connect the NAS.
# Needed once; remove it after the log says "Connected".
PAIR_CODE=

# Optional: the name shown in Admin (else the one typed when making the code).
NAS_LABEL=

# The database, for pg_dump and the database uptime check. Supabase dashboard >
# Connect > Session pooler (or Direct connection), with the password filled in.
# Stays on the NAS: never sent to GET.ride.
DATABASE_URL=

# The storage buckets are copied with the service_role key: Supabase dashboard
# > Project Settings > API Keys. Stays on the NAS. Leave empty to back up the
# database only.
SUPABASE_SERVICE_KEY=

# Where the encrypted backups go on the NAS (a shared folder of its own).
BACKUP_PATH=/volume1/getride-backups

# What pg_dump takes: your tables, sign-ins and the storage index.
PG_DUMP_SCHEMAS=public,auth,storage

# The test database the restore test uses: Supabase's own Postgres image, the
# same version as your project (dashboard > Project Settings > Infrastructure,
# e.g. 17.4.1.054 means supabase/postgres:17.4.1.054).
RESTORE_IMAGE=
# Any long random password, for the test database only.
RESTORE_DB_PASSWORD=

# Optional (README step 5): Hyper Backup's log inside the container, and the
# off-site task's name, so Admin shows when the last off-site copy ran.
HYPERBACKUP_LOG=
HYPERBACKUP_TASK=
