# Copy to .env next to docker-compose.yml and fill in. See README.md.

# The nas-maps function of your GET.ride backend.
GETRIDE_URL=https://rqlavogkgywxspuxgiwk.supabase.co/functions/v1/nas-maps

# The connection code from Admin > Settings > Office NAS > Maps > Connect a NAS.
# Needed once; remove it after the agent says "Connected".
PAIR_CODE=

# Optional: the name shown in Admin (else the one typed when making the code).
NAS_LABEL=

# The two public hostnames of the Cloudflare Tunnel (README.md, step 2).
MAPS_URL=https://maps.getride.my
TILES_URL=https://tiles.getride.my

# The tunnel's token (Cloudflare Zero Trust > Networks > Tunnels).
TUNNEL_TOKEN=

# The secret GET.ride sends with every route and search. Make it with
#   openssl rand -hex 32
# It stays on the NAS: the agent hands it to GET.ride when it checks in.
MAPS_SECRET=

# Optional: which web pages may draw the map (a regular expression on the
# page's origin). Default: getride.my and its subdomains.
# TILES_ORIGINS=^https://([a-z0-9-]+\.)*getride\.my$
