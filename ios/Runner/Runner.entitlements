<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. Xcode signs App Store builds as "production"
	     from the distribution profile, which must come from an App ID with
	     Push Notifications enabled (see docs/store-release.md). -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Passkeys saved for www.getride.my (the relying party set in Supabase →
	     Authentication → Passkeys). The domain side is the webcredentials
	     entry in apple-app-site-association (scripts/ci/app_links.ts). The
	     App ID needs Associated Domains, and the App Store profile must be
	     made after it was turned on, or signing fails. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>webcredentials:www.getride.my</string>
	</array>
</dict>
</plist>
