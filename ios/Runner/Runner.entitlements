<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push Notifications. Xcode signs App Store builds as "production"
	     from the distribution profile, which must come from an App ID with
	     Push Notifications enabled (see docs/store-release.md). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
