<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing of the app leaves the phone in a backup or a device transfer:
     its storage holds the sign-in session (and on the gateway, its device
     key). Android 12 and later read this; allowBackup="false" covers older. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
