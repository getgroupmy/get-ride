<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Normal (install-time) permission: the connection type for Admin →
         Session History (NetworkInfoChannel). Nothing is asked of the user. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Live location in the background (a trip, a driver online, the meter):
         geolocator's foreground service, with its notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <!-- "Allow all the time", asked only when Admin → App Settings →
         Permissions holds Android partners to it before going online
         (MainActivity.requestLocationAlways). Declared, Google Play asks for
         the background-location declaration in Play Console. Geolocator
         adds it to its own request only when location is already "While
         using the app", which the app never asks again. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- "Always on" (BackgroundLocation.kt, migration 0272): with location
         already allowed all the time (never asked for by it), the phone
         reports where it is about every 15 minutes or after ~500 m while
         the app is closed. Android forgets that request on a reboot or an
         update; this normal (install-time) permission lets it be renewed. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- flutter_callkit_incoming also asks for a camera foreground service, for
         video calls. Every GET.ride call is voice only (CallKitParams type 0,
         and the plugin adds the camera type only to a video call), so it is
         taken out: Play makes each foreground service type be declared and
         justified, and this one has no use. Its call service keeps phoneCall
         and microphone (below). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" tools:node="remove"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Android 13+: asked for at sign-in, before the push token is stored. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Bluetooth LE OBD-II readers (Meter Digital). Android 12+ asks for scan
         and connect only; older versions scan under the location permission
         the app already holds. -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
    <!-- The phones find each other at pickup (reliability Phase D): this phone advertises its trip token. -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30"/>
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30"/>
    <application
        android:label="GET.ride"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:replace="android:allowBackup,android:fullBackupContent,android:dataExtractionRules"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- singleTask: there is only ever one copy of the app. The call
             screen (flutter_callkit_incoming) opens the app from its own
             task; under singleTop that started a second MainActivity, a
             second Flutter engine racing the first for the session (which
             signed the phone out, and so stopped its push), and a call
             that ended on the new copy's home screen. Now the running app
             is brought forward and handed the intent (onNewIntent).
             No taskAffinity="" (Flutter's template default): with it the
             app's window has no affinity, so Android could only find it by
             the exact component that opened it, and the launcher opens it
             through an icon alias while a call opens MainActivity, so a
             call still got a window of its own. With the app's own
             affinity every way in lands in the one window. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <!-- Only for the Flutter tool, which looks for an <activity> with
                 this filter to start: every build takes it out again
                 (src/debug, src/profile and src/release AndroidManifest.xml),
                 so the launcher entry is the AppIcon_ alias below. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- My QR links: a phone camera scanning a code opens the app on
                 it (lib/src/core/my_qr.dart). Flutter hands the whole URI to
                 the router (lib/src/app.dart). Explicit, though it is
                 Flutter's default: a plugin that turns it off would leave
                 these links opening a blank home screen. -->
            <meta-data android:name="flutter_deeplinking_enabled" android:value="true"/>
            <!-- Android App Links, verified against
                 https://qr.getride.my/.well-known/assetlinks.json (written by
                 .github/workflows/deploy-web.yml), so no "open with" chooser.
                 Only the three code paths: the rest of the host is the web app. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="qr.getride.my" android:pathPrefix="/ref/"/>
                <data android:scheme="https" android:host="qr.getride.my" android:pathPrefix="/me/"/>
                <data android:scheme="https" android:host="qr.getride.my" android:pathPrefix="/now/"/>
            </intent-filter>
            <!-- getride://<ref|me|now>/<token>, the app-scheme form of a code. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="getride" android:host="ref"/>
                <data android:scheme="getride" android:host="me"/>
                <data android:scheme="getride" android:host="now"/>
            </intent-filter>
        </activity>
        <!-- The home-screen icons (lib/src/core/app_icons.dart): one alias of
             MainActivity per icon, exactly one enabled. The icon is switched by
             enabling another (AppIconChannel.kt); a new icon needs its alias
             here, its artwork (scripts/seasonal_icons.py) and its catalog entry.
             Deep links stay on MainActivity, so they work under any icon. -->
        <activity-alias
            android:name=".AppIcon_standard"
            android:targetActivity=".MainActivity"
            android:icon="@mipmap/ic_launcher"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity-alias>
